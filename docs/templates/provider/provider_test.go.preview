func TestAllHandlersRequestsOutputsAndSchemas(t *testing.T) {
	server := testkit.NewServerWithOptions(
		t,
		http.HandlerFunc(func(
			writer http.ResponseWriter,
			request *http.Request,
		) {
			// Assert fixed method/path/query/body/version/auth and return one
			// documented bounded fixture per operation.
			TODO_SERVE_REVIEWED_PROVIDER_FIXTURES(t, writer, request)
		}),
		testkit.ServerOptions{
			Provider:         string(Definition.Type),
			MaxResponseBytes: TODO_REVIEWED_MAX_RESPONSE_BYTES,
		},
	)
	source := &clientSource{client: server.Client}
	handlers := newHandlers(source)

	for _, testCase := range TODO_EVERY_TOOL_SUCCESS_CASE {
		result, err := handlers[testCase.handlerKey](
			context.Background(),
			testCase.call,
		)
		if err != nil || result.Failed() {
			t.Fatalf("Tool failed: err=%v failure=%+v", err, result.Failure)
		}
		TODO_ASSERT_OUTPUT_SCHEMA(t, testCase.call.ToolID, result.Structured)
	}
}

