                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "列出全部 Connector（含运行状态）",
                "operationId": "listConnectors",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/catalogsvc.Item"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
